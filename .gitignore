# This repository is PUBLIC. Nothing personal goes into it:
# footage, pictures of people, calibration clicks, player settings, reviews,
# statistics, databases, logs, credentials. All of that stays on the laptop.
# Before publishing, run: python scripts/check_public.py

# Personal data folders
data/
outputs/
models/

